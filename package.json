{
  "name": "@kyrielle/logger",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Julien Capellari <julien.capellari@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jujulego/kyrielle-logger"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "./dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint .",
    "clean": "shx rm -r dist",
    "build": "jill group 'build:esm // build:types'",
    "build:esm": "swc src -d dist --strip-leading-paths",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "vitest run --typecheck"
  },
  "dependencies": {
    "@jujulego/quick-tag": "^1.0.1",
    "@swc/helpers": "^0.5.3",
    "kyrielle": "^2.2.1",
    "pretty-ms": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@jujulego/jill": "2.5.2",
    "@jujulego/vite-plugin-swc": "1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@swc/cli": "0.7.9",
    "@swc/core": "1.15.5",
    "@types/eslint__js": "9.14.0",
    "@types/node": "24.10.4",
    "@typescript-eslint/utils": "8.49.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/eslint-plugin": "1.5.2",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "shx": "0.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0",
    "vite": "7.2.7",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "dependenciesMeta": {
    "vitest@3.2.4": {
      "unplugged": true
    }
  },
  "packageManager": "yarn@4.12.0"
}
